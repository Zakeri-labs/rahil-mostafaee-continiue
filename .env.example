# Public origin used for canonical absolute sitemap and robots URLs.
NEXT_PUBLIC_SITE_URL=https://example.com

# Supabase project configuration. Use separate projects/credentials for development and production.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional direct/pooler Postgres connection string for server-side database tooling.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# Confidential case intake email configuration.
# Set CASE_INTAKE_DEV_MODE=true locally to validate and log a safe summary
# without contacting Resend. Keep these values server-side only.
RESEND_API_KEY="re_your_key_here"
CASE_INTAKE_FROM_EMAIL="Case Review <verified-sender@example.com>"
CASE_INTAKE_RECIPIENTS="first-recipient@example.com,second-recipient@example.com"
CASE_INTAKE_DEV_MODE="true"
CASE_INTAKE_REPLY_TO_EMAIL=""

# Public payment client token (use a test token for development and a live token for production).
NEXT_PUBLIC_PAYMENTS_CLIENT_TOKEN="pk_test_or_pk_live_token"

# Server-side payment configuration
STRIPE_SANDBOX_API_KEY=your-sandbox-api-key
STRIPE_LIVE_API_KEY=your-live-api-key
LOVABLE_API_KEY=your-lovable-api-key
PAYMENTS_SANDBOX_WEBHOOK_SECRET=your-sandbox-webhook-secret
PAYMENTS_LIVE_WEBHOOK_SECRET=your-live-webhook-secret
